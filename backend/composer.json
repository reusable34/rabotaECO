{
    "name": "eco-client-cabinet/backend",
    "description": "Backend API for Eco Client Cabinet",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "php": ">=8.0",
        "yiisoft/yii2": "~2.0.0",
        "yiisoft/yii2-swiftmailer": "~2.1",
        "yiisoft/yii2-faker": "~2.0.0",
        "sizeg/yii2-jwt": "^3.0",
        "firebase/php-jwt": "^6.0",
        "bower-asset/jquery": "^3.6.0"
    },
    "require-dev": {
        "yiisoft/yii2-gii": "~2.2"
    },
    "autoload": {
        "psr-4": {
            "common\\": "common/",
            "api\\": "api/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "process-timeout": 1800,
        "fxp-asset": {
            "enabled": false
        },
        "allow-plugins": {
            "fxp/composer-asset-plugin": true,
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "post-install-cmd": [
            "php -r \"copy('.env.example', '.env');\""
        ]
    }
}
